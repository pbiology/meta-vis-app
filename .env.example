# Defaults for ingest.py (auto-loaded from the repo root).
# Copy to .env and fill in. .env is gitignored.

# --- Keycloak ---
# KEYCLOAK_URL=http://localhost:8081
# KEYCLOAK_REALM=meta-vis
# KEYCLOAK_CLI_CLIENT_ID=meta-vis-cli
# KEYCLOAK_ROLE_CLIENT=meta-vis-frontend

# --- Service-account (recommended for automation + corp KCs) ---
# Setting this makes the CLI use the client_credentials grant; username and
# password are ignored. The CLI authenticates as the meta-vis-cli service
# account; assign roles to that service account in Keycloak.
# KEYCLOAK_CLIENT_SECRET=

# --- Password grant (local-dev KC fallback) ---
# Only used when KEYCLOAK_CLIENT_SECRET is unset.
# KEYCLOAK_USERNAME=
# KEYCLOAK_PASSWORD=

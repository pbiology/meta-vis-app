# Template for `backend/.env.stage` and `backend/.env.prod` (both
# gitignored). Copy this file to one of those exact filenames and fill in
# real values for your deploy. The compose `env_file:` (or your K8s
# ConfigMap/Secret) should point at the copied file.
#
# Values pre-filled here are safe defaults that most deploys should keep.
# Blank values are site-specific and MUST be set.
#
# For local development do NOT copy this file. Use `backend/.env.dev`
# (committed dev defaults) + `backend/.env` (your secrets) instead.
#
# See `backend/.env.example` for the encyclopedic per-key reference (every
# optional key, every fallback, every comment). This template is the
# deploy-time minimum.

# --- MongoDB ---
# Prefer the URI form for production. Carries replicaSet, tls, multi-host.
MONGODB_URI=
MONGODB_DB_NAME=meta-vis
MONGODB_DIRECT_CONNECTION=false
MONGODB_USE_TRANSACTIONS=true

# --- App ---
APP_ENV=production
LOG_LEVEL=info

# --- Auth (Keycloak) ---
# Realm public URL — must equal the `iss` claim of incoming tokens.
KEYCLOAK_ISSUER=

# Keep both clients in the allowlist: the SPA (browser logins) AND the
# ingest CLI (HPC uploads via ingest.py). Dropping `meta-vis-cli` breaks
# every `ingest.py` upload with a 401 "Token was not issued for this
# client".
KEYCLOAK_CLIENT_IDS=meta-vis-frontend,meta-vis-cli

# KC client whose client-roles drive app authorization.
KEYCLOAK_ROLE_CLIENT=meta-vis-frontend

# Optional. Set when the backend pod cannot reach the public KC hostname.
# KEYCLOAK_JWKS_URL=

# Legacy. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- CORS ---
# Deployed frontend origin(s). Scheme + host, no trailing slash.
CORS_ORIGINS=

# --- Object storage (optional) ---
# Leave unset to keep blobs in MongoDB. See `.env.example` for the full
# S3/MinIO block.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_BUCKET=meta-vis

# Production image for the FastAPI backend.
#
# Two stages:
#   1. builder — installs runtime deps (no [dev] extras) from uv.lock into a venv.
#   2. runtime — slim image, copies the venv + app, runs as non-root.
#
# No --reload, no bind-mounts. The dev Dockerfile alongside this one is still
# used for `docker compose up` against backend/docker-compose.yml.

# ---------- builder ----------
FROM python:3.13-slim-trixie AS builder

# uv binary copied from its pinned image — installing it with pip would itself
# be an unlocked install. Stays in the builder; the runtime stage never sees it.
COPY --from=ghcr.io/astral-sh/uv:0.12.18 /uv /usr/local/bin/uv

# Build the venv at /opt/venv with the image's own Python (no uv-managed
# download), so its interpreter symlinks stay valid in the runtime stage, which
# uses the same base image.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_NO_CACHE=1

WORKDIR /build

COPY pyproject.toml uv.lock ./

# Install only runtime deps — no [dev] extras (ruff/mypy/pytest stay out).
#   --locked             fail if uv.lock is out of date with pyproject.toml
#   --no-build           wheels only: never execute a package's build scripts
#   --no-install-project the app runs from /app (copied below), not site-packages
RUN uv sync --locked --no-build --no-install-project

# ---------- runtime ----------
FROM python:3.13-slim-trixie AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# Non-root user — keeps container compatible with restrictive runtimes
# (OpenShift / hardened k8s) and avoids running uvicorn as root.
RUN groupadd --system --gid 1001 app \
    && useradd --system --uid 1001 --gid app --home-dir /app --shell /sbin/nologin app

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
# Files are left root-owned (world-readable). The non-root `app` user can read
# and execute its code but cannot modify it at runtime — defense against an
# attacker persisting changes inside the container (SonarQube docker:S6504).
COPY app ./app
COPY outbreak_configs.json controls_taxa.json ./

USER app

EXPOSE 8000

# --proxy-headers + --forwarded-allow-ips=* so Host/Scheme are taken from
# the upstream nginx (frontend container + the host nginx in front of it).
# No --reload. Workers tuned for a small VM; bump on a beefier host.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "2", \
     "--proxy-headers", \
     "--forwarded-allow-ips=*"]

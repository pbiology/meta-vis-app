# Backend production / deployment env template.
#
# This file is committed as the canonical reference for every key the backend
# expects. Copy it to a gitignored file (e.g. `backend/.env.prod` or
# `backend/.env.stage`) and fill in real values for your deploy. Whichever
# filename you choose, point your runtime at it via docker-compose
# `env_file:`, the K8s ConfigMap/Secret, or your shell.
#
# Required vs optional is called out per block. No localhost fallbacks live
# in code — every required key below MUST be set or the backend fails fast at
# startup with a Pydantic ValidationError.
#
# For local development do NOT copy this file. Use `backend/.env.dev`
# (committed dev defaults) + `backend/.env` (your secrets) instead.

# --- MongoDB (REQUIRED) -----------------------------------------------------
# Two ways to point at Mongo. Pick one:
#
# 1. Connection URI — preferred for production (carries replicaSet=, tls=,
#    multiple seed hosts, query params). When set, the host/port/user/pass
#    fields below are IGNORED.
#
#       MONGODB_URI=mongodb://meta-vis-app:CHANGE_ME@mongo-1.internal:27017,mongo-2.internal:27017/meta-vis?authSource=admin&replicaSet=rs0
#
# 2. Discrete fields — adequate for single-host deploys.
#
#       MONGODB_HOST=mongo.internal
#       MONGODB_PORT=27017
#       MONGODB_USERNAME=meta-vis-app
#       MONGODB_PASSWORD=<from-secret>
#       MONGODB_AUTH_SOURCE=admin

MONGODB_URI=
MONGODB_DB_NAME=meta-vis

# Append `directConnection=true` to the Mongo URL. Keep true for a single-node
# replica set behind a port mapping; set false for a real mongodb+srv URL or
# a multi-host cluster URI.
MONGODB_DIRECT_CONNECTION=false

# Wrap ingest + case-mutation writes in a multi-document transaction.
# Requires a replica set or sharded cluster. Set false on a standalone mongod
# (transactions will be rejected otherwise) and accept that a mid-sequence
# failure can leave partial writes behind.
MONGODB_USE_TRANSACTIONS=true

# --- App --------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info

# --- Auth (REQUIRED) --------------------------------------------------------
# Keycloak issuer URL — the realm's public URL. Must match the `iss` claim of
# incoming tokens exactly. This is the URL the SPA also uses, so use the
# browser-facing hostname here.
KEYCLOAK_ISSUER=

# Comma-separated list of client IDs whose tokens this API accepts. Each
# incoming token's `azp` claim must match one of these. Defaults cover the
# SPA and the ingest CLI.
KEYCLOAK_CLIENT_IDS=meta-vis-frontend,meta-vis-cli

# The KC client whose client-roles drive app authorization. Tokens are
# inspected at `resource_access[<role_client>].roles`.
KEYCLOAK_ROLE_CLIENT=meta-vis-frontend

# Optional JWKS override. If the backend pod cannot reach the public KC
# hostname, point this at an in-cluster URL. The `iss` claim is still
# validated against KEYCLOAK_ISSUER above; only the cert fetch URL changes.
# KEYCLOAK_JWKS_URL=

# Legacy — still required by Settings even though JWTs are now KC-signed.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- CORS (REQUIRED) --------------------------------------------------------
# Comma-separated list of allowed origins. List the deployed frontend's
# origin exactly (scheme + host, no trailing slash).
CORS_ORIGINS=

# --- Object storage (OPTIONAL) ----------------------------------------------
# Leave unset to use the MongoDB `blobs` collection. Setting
# OBJECT_STORAGE_ENDPOINT activates the S3/MinIO path in app/blob_store.py.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_BUCKET=meta-vis

# --- Optional integrations --------------------------------------------------
# NCBI E-utilities — raises rate limit from 3 to 10 req/s.
# NCBI_API_KEY=

# Freshdesk — base URL pattern for case ticket links. Must include {ticket_id}.
# Leave unset to disable ticket links in the UI.
# FRESHDESK_BASE_URL=https://<subdomain>.freshdesk.com/a/tickets/{ticket_id}

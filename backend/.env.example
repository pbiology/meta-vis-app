# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB_NAME=meta-vis-dev
MONGODB_USERNAME=meta_vis_app
MONGODB_PASSWORD=<choose-a-strong-password>
MONGO_ROOT_PASSWORD=<choose-a-strong-root-password>
MONGODB_AUTH_SOURCE=admin

# App
APP_ENV=development
LOG_LEVEL=info

# Authentication
# JWT_SECRET: Must be at least 32 characters for security (256-bit minimum).
# Never commit real secrets to version control.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-a-random-string-minimum-32-characters>

# NCBI E-utilities — optional, raises rate limit from 3 to 10 req/s
# NCBI_API_KEY=<your-key>

# Object storage — uncomment to use MinIO instead of MongoDB for Krona files
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_ACCESS_KEY=<choose-a-username>
# OBJECT_STORAGE_SECRET_KEY=<choose-a-strong-password>
# OBJECT_STORAGE_BUCKET=meta-vis

# CORS — comma-separated list of allowed origins
# For development: http://localhost:5173
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173
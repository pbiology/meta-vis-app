# Committed local-dev defaults for the backend.
#
# Loaded by `docker compose up` and intended to also work for bare-metal
# `uvicorn app.main:app --reload` from this directory. Secrets are NOT here —
# put MONGODB_PASSWORD, MONGO_ROOT_PASSWORD, and JWT_SECRET in `backend/.env`
# (gitignored). Compose loads `.env.dev` first, then `.env`, so `.env`
# overrides anything below for local tweaks.

# --- MongoDB (compose stack) ------------------------------------------------
# `mongodb` is the service name inside docker-compose.yml. For bare-metal
# dev, override with MONGODB_HOST=localhost in backend/.env.
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DB_NAME=meta-vis-dev
MONGODB_USERNAME=meta_vis_app
MONGODB_AUTH_SOURCE=admin

# --- App --------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# --- Object storage (compose MinIO) -----------------------------------------
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=meta-vis

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Keycloak ---------------------------------------------------------------
# Defaults below point at the Clinical Genomics stage Keycloak — it is
# reachable from the host browser and from the backend container, so no
# extra config is needed to get dev working.
#
# For fully-offline dev, run `make keycloak-up` to start a local KC on
# :8081 (realm `meta-vis`, imported from keycloak/realm-export.json), then
# override the two lines below in backend/.env:
#   KEYCLOAK_ISSUER=http://localhost:8081/realms/meta-vis
#   KEYCLOAK_JWKS_URL=http://host.docker.internal:8081/realms/meta-vis/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://keycloak-stage.cg-orchestration.sys.scilifelab.se/realms/clinical-genomics
KEYCLOAK_CLIENT_IDS=meta-vis-frontend,meta-vis-cli
KEYCLOAK_ROLE_CLIENT=meta-vis-frontend

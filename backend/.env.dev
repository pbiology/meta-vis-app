# Committed local-dev defaults for the backend.
#
# Loaded by `docker compose up` and by bare-metal `uvicorn app.main:app
# --reload`. Holds only values that are the SAME in both contexts. Secrets
# (MONGODB_PASSWORD, MONGO_ROOT_PASSWORD, JWT_SECRET) and service-topology
# addresses go elsewhere:
#
#   * Secrets + bare-metal addresses (MONGODB_HOST=localhost, etc.) →
#     backend/.env (gitignored).
#   * Compose service addresses (MONGODB_HOST=mongodb, MinIO endpoint) →
#     the backend `environment:` block in docker-compose.yml, which beats
#     both env files inside the compose network.
#
# Compose loads `.env.dev` first, then `.env`, so `.env` overrides anything
# below for per-developer tweaks.

# --- MongoDB ----------------------------------------------------------------
# Host is NOT set here — it's context-specific (compose vs bare-metal). Port,
# db, user, and auth source are the same everywhere.
MONGODB_PORT=27017
MONGODB_DB_NAME=meta-vis-dev
MONGODB_USERNAME=meta_vis_app
MONGODB_AUTH_SOURCE=admin

# --- App --------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# --- Object storage ---------------------------------------------------------
# Endpoint is context-specific (set per-context, see header). Only the bucket
# name is shared.
OBJECT_STORAGE_BUCKET=meta-vis

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Keycloak ---------------------------------------------------------------
# Defaults below point at the Clinical Genomics stage Keycloak — it is
# reachable from the host browser and from the backend container, so no
# extra config is needed to get dev working.
#
# For fully-offline dev, run `make keycloak-up` to start a local KC on
# :8081 (realm `meta-vis`, imported from keycloak/realm-export.json), then
# override the two lines below in backend/.env:
#   KEYCLOAK_ISSUER=http://localhost:8081/realms/meta-vis
#   KEYCLOAK_JWKS_URL=http://host.docker.internal:8081/realms/meta-vis/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://keycloak-stage.cg-orchestration.sys.scilifelab.se/realms/clinical-genomics
KEYCLOAK_CLIENT_IDS=meta-vis-frontend,meta-vis-cli
KEYCLOAK_ROLE_CLIENT=meta-vis-frontend

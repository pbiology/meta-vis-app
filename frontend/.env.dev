# Committed local-dev defaults for the frontend.
#
# Loaded by `npm run dev` automatically (Vite picks up `.env` and `.env.dev`
# files in that order, with the latter winning when present). Inside the
# compose stack, docker-compose.yml passes VITE_API_PROXY_TARGET via the
# `environment:` block so the SPA's dev server proxies to the backend
# container instead of localhost.

# Local Keycloak (run `make keycloak-up` to start it). To point at a
# different KC instead, override these in frontend/.env (gitignored).
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/meta-vis
VITE_OIDC_CLIENT_ID=meta-vis-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Where the dev server proxies /api/* calls. localhost works for bare-metal
# `npm run dev`. Compose overrides this to http://backend:8000.
VITE_API_PROXY_TARGET=http://localhost:8000

# Frontend production / deployment env template.
#
# Vite bakes VITE_* values into the static bundle at build time. They are
# NOT runtime-configurable — to change them you must rebuild the image.
#
# For a stage or prod image build, copy this file to `frontend/.env.stage`
# or `frontend/.env.prod` (both gitignored), fill in real values, then run:
#
#   docker buildx build --platform linux/amd64 -f frontend/Dockerfile.prod \
#     --build-arg VITE_MODE=stage \
#     -t <your-image-tag> ./frontend --push
#
# Vite's `--mode stage` automatically loads `frontend/.env.stage`. The
# Makefile has `image-frontend-stage` / `image-frontend-prod` targets that
# wrap this command.
#
# For local development do NOT copy this file. Use `frontend/.env.dev`
# (committed dev defaults) + `frontend/.env` (your overrides) instead.

# --- Keycloak (REQUIRED) ----------------------------------------------------
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=meta-vis-frontend
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=

# Optional: KC client whose client-roles drive UI authz. Defaults to
# VITE_OIDC_CLIENT_ID — only set if roles live on a different client.
# VITE_OIDC_ROLE_CLIENT=meta-vis-frontend

# --- Backend (dev only) -----------------------------------------------------
# Only used by `npm run dev` (Vite's proxy points /api/* here). Production
# builds ignore this — the prod nginx config does the API proxying. Safe to
# leave unset for a build-only env file.
# VITE_API_PROXY_TARGET=

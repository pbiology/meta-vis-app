# Frontend env template — covers both local dev and image builds.
#
# Vite reads VITE_* values at build time and bakes them into the bundle.
# The prod image also reads the same VITE_OIDC_* keys from container env at
# startup (see frontend/docker-entrypoint.d/10-inject-env.sh); runtime values
# override the baked-in defaults. The values you need depend on what you're
# doing:
#
# Local development
#   Copy this file to `frontend/.env` (gitignored) and fill it in. `npm run
#   dev` and `docker compose up` both read it. The compose stack overrides
#   VITE_API_PROXY_TARGET to point at the backend container — everything
#   else (including which Keycloak to use) comes from your frontend/.env.
#
# Stage / prod image build
#   Copy this file to `frontend/.env.stage` or `frontend/.env.prod` (both
#   gitignored), fill in real values, then build with the matching Vite mode:
#
#     docker buildx build --platform linux/amd64 -f frontend/Dockerfile.prod \
#       --build-arg VITE_MODE=stage \
#       -t <your-image-tag> ./frontend --push
#
#   Vite's `--mode stage` automatically loads `frontend/.env.stage`. The
#   Makefile has `image-frontend-stage` / `image-frontend-prod` targets that
#   wrap this command. You can leave the OIDC values empty in `.env.stage` /
#   `.env.prod` and instead inject them at deploy time as container env vars
#   — see `docker-compose.prod.yml`.

# --- Keycloak (REQUIRED) ----------------------------------------------------
# Which Keycloak to authenticate against — a per-environment choice. For a
# fully-local setup run `make keycloak-up` and use:
#   VITE_OIDC_AUTHORITY=http://localhost:8081/realms/meta-vis
# Otherwise point it at your remote realm's public URL.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=meta-vis-frontend
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Optional: KC client whose client-roles drive UI authz. Defaults to
# VITE_OIDC_CLIENT_ID — only set if roles live on a different client.
# VITE_OIDC_ROLE_CLIENT=meta-vis-frontend

# --- Backend (dev only) -----------------------------------------------------
# Where `npm run dev` proxies /api/* calls. Required for bare-metal dev — set
# it to the local backend. The compose stack overrides this to
# http://backend:8000, so leave it as the bare-metal value here. Production
# builds ignore it entirely (the prod nginx config does the API proxying).
VITE_API_PROXY_TARGET=http://localhost:8000

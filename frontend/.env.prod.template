# Template for `frontend/.env.stage` and `frontend/.env.prod` (both
# gitignored). Copy this file to one of those exact filenames — Vite's
# `--mode stage` and `--mode prod` look them up by name at build time.
#
# Fill in real site values for your deploy. Vite bakes these into the
# static bundle, so each deploy target needs its own copy + its own
# rebuild. The Dockerfile.prod build accepts the mode as a build-arg:
#
#   docker buildx build --platform linux/amd64 -f frontend/Dockerfile.prod \
#     --build-arg VITE_MODE=stage \
#     -t <your-image-tag> ./frontend --push
#
# This file itself is just a placeholder reference. It is never read by
# Vite (only `.env`, `.env.<mode>`, and `.env.<mode>.local` are).

# Keycloak — the realm's public, browser-facing URL.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=meta-vis-frontend
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=

# Optional: KC client whose client-roles drive UI authz.
# VITE_OIDC_ROLE_CLIENT=meta-vis-frontend

# Not needed for prod image builds (the prod nginx proxies /api/* itself).
# Only `npm run dev` reads this. Leave commented out.
# VITE_API_PROXY_TARGET=

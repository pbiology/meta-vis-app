# Production image for the React SPA.
#
# Builder runs `npm run build` to produce static assets in /app/dist.
# Runtime is plain nginx serving those assets and proxying /api/ to the
# backend container (option X: single upstream per app — the host nginx
# proxies one upstream and knows nothing about /api routing).

# ---------- builder ----------
FROM node:22-trixie AS build
WORKDIR /app

# Pick which Vite mode to build for. Each mode loads `frontend/.env.<mode>`
# (those files are gitignored — supply your own). Override at build time:
#   docker buildx build --build-arg VITE_MODE=stage ...
ARG VITE_MODE=production

# Copy lockfile separately for better layer caching.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build -- --mode ${VITE_MODE}

# ---------- runtime ----------
# nginx-unprivileged runs as non-root (UID 101) and listens on 8080 by
# default — which matches our nginx.conf and the compose port mapping
# (SonarQube docker:S6471). Stock `nginx` would run as root.
FROM nginxinc/nginx-unprivileged:1.28-trixie

# Replace the stock default server block with ours.
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# Inject runtime env vars before nginx starts.
COPY docker-entrypoint.d/10-inject-env.sh /docker-entrypoint.d/10-inject-env.sh

# Production image for the React SPA.
#
# Builder runs `npm run build` to produce static assets in /app/dist.
# Runtime is plain nginx serving those assets and proxying /api/ to the
# backend container (option X: single upstream per app — the host nginx
# proxies one upstream and knows nothing about /api routing).

# ---------- builder ----------
FROM node:20-bullseye AS build
WORKDIR /app

# Copy lockfile separately for better layer caching.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---------- runtime ----------
FROM nginx:1.27-bullseye

# Replace the stock default server block with ours.
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
